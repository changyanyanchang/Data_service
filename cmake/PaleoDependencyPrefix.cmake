include_guard(GLOBAL)

set(PALEO_DEPENDENCY_PREFIX "" CACHE PATH
  "Prepared Qt and native library prefix (OSGeo4W root or Linux usr)")

function(paleo_require_dependency_path path component)
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "Dependency prefix is missing ${component}: ${path}")
  endif()
  file(REAL_PATH "${PALEO_DEPENDENCY_PREFIX}" prefix)
  file(REAL_PATH "${path}" resolved)
  if(WIN32)
    string(TOLOWER "${prefix}" prefix)
    string(TOLOWER "${resolved}" resolved)
  endif()
  cmake_path(IS_PREFIX prefix "${resolved}" NORMALIZE inside)
  if(NOT inside)
    message(FATAL_ERROR
      "${component} resolved outside dependency prefix ${PALEO_DEPENDENCY_PREFIX}: ${path}")
  endif()
endfunction()

function(paleo_require_dependency_import target)
  if(NOT TARGET "${target}")
    message(FATAL_ERROR "Dependency prefix did not define imported target ${target}")
  endif()
  get_target_property(configurations "${target}" IMPORTED_CONFIGURATIONS)
  set(properties IMPORTED_LOCATION IMPORTED_IMPLIB)
  if(configurations)
    foreach(configuration IN LISTS configurations)
      list(APPEND properties "IMPORTED_LOCATION_${configuration}" "IMPORTED_IMPLIB_${configuration}")
    endforeach()
  endif()
  set(found FALSE)
  foreach(property IN LISTS properties)
    get_target_property(path "${target}" "${property}")
    if(path)
      paleo_require_dependency_path("${path}" "${target}")
      set(found TRUE)
    endif()
  endforeach()
  if(NOT found)
    message(FATAL_ERROR "Dependency prefix did not supply an imported library or tool for ${target}")
  endif()
  get_target_property(headers "${target}" INTERFACE_INCLUDE_DIRECTORIES)
  foreach(directory IN LISTS headers)
    if(IS_ABSOLUTE "${directory}")
      paleo_require_dependency_path("${directory}" "${target} headers")
    endif()
  endforeach()
endfunction()

macro(paleo_find_base_qt)
  if(PALEO_DEPENDENCY_PREFIX)
    find_package(Qt6 REQUIRED CONFIG COMPONENTS ${ARGN} NO_DEFAULT_PATH
      PATHS "${PALEO_DEPENDENCY_PREFIX}/apps/qt6" "${PALEO_DEPENDENCY_PREFIX}")
    paleo_require_dependency_path("${Qt6_DIR}/Qt6Config.cmake" "Qt6 CMake configuration")
    foreach(_paleo_qt_module IN ITEMS ${ARGN})
      paleo_require_dependency_import("Qt6::${_paleo_qt_module}")
    endforeach()
    foreach(_paleo_qt_tool IN ITEMS moc rcc uic)
      if(TARGET "Qt6::${_paleo_qt_tool}")
        paleo_require_dependency_import("Qt6::${_paleo_qt_tool}")
      endif()
    endforeach()
  else()
    find_package(Qt6 REQUIRED COMPONENTS ${ARGN})
  endif()
endmacro()

function(paleo_find_base_zlib)
  if(NOT PALEO_DEPENDENCY_PREFIX)
    find_package(ZLIB REQUIRED)
    return()
  endif()
  if(NOT TARGET ZLIB::ZLIB)
    find_path(headers NAMES zlib.h PATHS "${PALEO_DEPENDENCY_PREFIX}/include"
      NO_DEFAULT_PATH NO_CACHE REQUIRED)
    find_library(library NAMES zlib z PATHS "${PALEO_DEPENDENCY_PREFIX}/lib"
      "${PALEO_DEPENDENCY_PREFIX}/lib/${CMAKE_LIBRARY_ARCHITECTURE}"
      NO_DEFAULT_PATH NO_CACHE REQUIRED)
    add_library(ZLIB::ZLIB UNKNOWN IMPORTED)
    set_target_properties(ZLIB::ZLIB PROPERTIES
      IMPORTED_LOCATION "${library}" INTERFACE_INCLUDE_DIRECTORIES "${headers}")
  endif()
  paleo_require_dependency_import(ZLIB::ZLIB)
endfunction()

function(paleo_find_base_zstd target_variable)
  if(PALEO_DEPENDENCY_PREFIX)
    find_package(zstd CONFIG REQUIRED NO_DEFAULT_PATH PATHS "${PALEO_DEPENDENCY_PREFIX}")
    paleo_require_dependency_path("${zstd_DIR}" "zstd CMake configuration")
  else()
    find_package(zstd CONFIG QUIET)
  endif()
  set(${target_variable} "" PARENT_SCOPE)
  foreach(candidate IN ITEMS zstd::libzstd zstd::libzstd_static zstd::libzstd_shared)
    if(TARGET "${candidate}")
      if(PALEO_DEPENDENCY_PREFIX)
        get_target_property(kind "${candidate}" TYPE)
        if(kind STREQUAL "INTERFACE_LIBRARY")
          get_target_property(link "${candidate}" INTERFACE_LINK_LIBRARIES)
          if(NOT link MATCHES "^zstd::libzstd_(static|shared)$")
            message(FATAL_ERROR "Unexpected zstd target link: ${candidate} -> ${link}")
          endif()
          paleo_require_dependency_import("${link}")
        else()
          paleo_require_dependency_import("${candidate}")
        endif()
      endif()
      set(${target_variable} "${candidate}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  if(PALEO_DEPENDENCY_PREFIX)
    message(FATAL_ERROR "Dependency prefix did not provide a zstd library target")
  endif()
endfunction()
