# Vendored copy of the workstation's headless seismic engine. No workstation/QGIS dependency.
add_library(pds_segyio STATIC vendor/segyio/src/segy.c)
target_include_directories(pds_segyio PRIVATE vendor/segyio/include)
if(MSVC)
  target_compile_definitions(pds_segyio PRIVATE HAVE_SYS_STAT_H HAVE_FSEEKI64 HAVE_FTELLI64 HAVE_FSTATI64)
else()
  target_compile_definitions(pds_segyio PRIVATE HAVE_SYS_STAT_H HAVE_FSEEKO HAVE_FTELLO _FILE_OFFSET_BITS=64)
endif()
set_target_properties(pds_segyio PROPERTIES AUTOMOC OFF)
file(GLOB PDS_ENGINE_SOURCES CONFIGURE_DEPENDS vendor/sbm/src/Data/Sgy/*.cpp vendor/sbm/src/Engine/*.cpp)
add_library(pds_sbm STATIC ${PDS_ENGINE_SOURCES} vendor/sbm/src/Render/ColorMap.cpp)
target_include_directories(pds_sbm PRIVATE vendor/sbm/src vendor/segyio/include vendor/glm)
target_compile_options(pds_sbm PRIVATE $<IF:$<CXX_COMPILER_ID:MSVC>,/Zc:char8_t-,-fno-char8_t>)
if(MSVC)
  target_compile_options(pds_sbm PRIVATE /utf-8 /w)
  target_compile_definitions(pds_sbm PRIVATE NOMINMAX)
endif()
target_link_libraries(pds_sbm PRIVATE pds_segyio Qt6::Core)
find_package(zstd CONFIG QUIET)
set(PDS_ZSTD_TARGET "")
foreach(candidate IN ITEMS zstd::libzstd zstd::libzstd_static zstd::libzstd_shared)
  if(TARGET ${candidate})
    set(PDS_ZSTD_TARGET ${candidate})
    break()
  endif()
endforeach()
if(PDS_ZSTD_TARGET)
  target_link_libraries(pds_sbm PRIVATE ${PDS_ZSTD_TARGET})
  target_compile_definitions(pds_sbm PUBLIC SEISMIC_HAVE_ZSTD)
endif()
set_target_properties(pds_sbm PROPERTIES AUTOMOC OFF)
