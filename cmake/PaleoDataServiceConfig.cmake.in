@PACKAGE_INIT@
if(PALEO_DEPENDENCY_PREFIX)
  include("${CMAKE_CURRENT_LIST_DIR}/PaleoDependencyPrefix.cmake")
  paleo_find_base_qt(Core Gui Sql)
  paleo_find_base_zlib()
  if(NOT "@PDS_ZSTD_TARGET@" STREQUAL "")
    paleo_find_base_zstd(_pds_zstd)
    if(NOT _pds_zstd STREQUAL "@PDS_ZSTD_TARGET@")
      message(FATAL_ERROR "PaleoDataService requires zstd target @PDS_ZSTD_TARGET@")
    endif()
    unset(_pds_zstd)
  endif()
else()
  include(CMakeFindDependencyMacro)
  find_dependency(Qt6 COMPONENTS Core Gui Sql)
  find_dependency(ZLIB)
  if(NOT "@PDS_ZSTD_TARGET@" STREQUAL "")
    find_dependency(zstd CONFIG)
  endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/PaleoDataServiceTargets.cmake")
check_required_components(PaleoDataService)
